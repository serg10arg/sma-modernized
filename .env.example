# ============================================================
# Variables de entorno del sistema sma-modernized
# Copia este archivo como .env y ajusta los valores
# ============================================================

# --- Config Server ---
CONFIG_SERVER_PORT=8888
CONFIG_GIT_URI=https://github.com/<tu-usuario>/sma-config-repo

# --- Eureka Server ---
EUREKA_SERVER_PORT=8761

# --- Gateway Server ---
GATEWAY_SERVER_PORT=8072

# --- Licensing Service ---
LICENSING_SERVICE_PORT=8080

# --- Organization Service ---
ORGANIZATION_SERVICE_PORT=8081

# --- Zipkin ---
ZIPKIN_PORT=9411

# Base de datos PostgreSQL (Etapa 3)
DB_NAME=sma_licensing
DB_USER=sma_user
DB_PASSWORD=sma_password
DB_HOST=postgres
DB_PORT=5432
